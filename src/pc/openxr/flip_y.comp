#version 450

// Compute shader to flip Y-axis of RGBA8 image data
// This replaces the CPU-based flip_y_rgba8 function

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly buffer SourceBuffer {
    uint data[];
} src;

layout(binding = 1) writeonly buffer DestBuffer {
    uint data[];
} dst;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    
    // Source index (normal Y)
    uint src_idx = y * pc.width + x;
    
    // Destination index (flipped Y)
    uint flipped_y = pc.height - 1 - y;
    uint dst_idx = flipped_y * pc.width + x;
    
    // Copy RGBA8 pixel (stored as uint32)
    dst.data[dst_idx] = src.data[src_idx];
}
